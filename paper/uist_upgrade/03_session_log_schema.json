{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lucia Session Log",
  "type": "object",
  "required": [
    "session_id",
    "timestamp",
    "device_mode",
    "stream",
    "sync",
    "task",
    "timing_ms",
    "result",
    "failure",
    "env"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Stable UUID for one run."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO8601 UTC timestamp."
    },
    "device_mode": {
      "type": "string",
      "enum": ["USB", "WIFI"]
    },
    "device_count": {
      "type": "integer",
      "minimum": 1
    },
    "stream": {
      "type": "object",
      "required": [
        "resolution",
        "fps_target",
        "latency_ms",
        "frame_drop_rate",
        "reconnect_count",
        "reconnect_time_ms_p95"
      ],
      "properties": {
        "resolution": {
          "type": "string",
          "description": "WxH"
        },
        "fps_target": {
          "type": "number",
          "minimum": 0
        },
        "fps_achieved": {
          "type": "number",
          "minimum": 0
        },
        "latency_ms": {
          "type": "object",
          "required": ["mean", "p50", "p95"],
          "properties": {
            "mean": { "type": "number", "minimum": 0 },
            "p50": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 }
          }
        },
        "frame_drop_rate": {
          "type": "number",
          "minimum": 0
        },
        "stutter_count": {
          "type": "integer",
          "minimum": 0
        },
        "reconnect_count": {
          "type": "integer",
          "minimum": 0
        },
        "reconnect_time_ms_p95": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sync": {
      "type": "object",
      "required": ["enabled", "delta_t_ms", "sync_fail_rate"],
      "properties": {
        "enabled": { "type": "boolean" },
        "delta_t_ms": {
          "type": "object",
          "required": ["mean", "p95"],
          "properties": {
            "mean": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 }
          }
        },
        "sync_fail_rate": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "frame_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "clip_path": {
          "type": "string"
        },
        "stereo_pair_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["type", "query_text", "module_version"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["navigation", "measurement", "video_qa"]
        },
        "query_text": {
          "type": "string"
        },
        "prompt_variant": {
          "type": "string",
          "enum": ["no_anchor", "min_anchor", "structured_anchor"]
        },
        "module_version": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        }
      }
    },
    "timing_ms": {
      "type": "object",
      "required": [
        "capture",
        "prompt_build",
        "inference",
        "postprocess",
        "render",
        "end_to_end"
      ],
      "properties": {
        "capture": { "type": "number", "minimum": 0 },
        "prompt_build": { "type": "number", "minimum": 0 },
        "inference": { "type": "number", "minimum": 0 },
        "postprocess": { "type": "number", "minimum": 0 },
        "render": { "type": "number", "minimum": 0 },
        "end_to_end": { "type": "number", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "required": ["success", "confidence"],
      "properties": {
        "success": { "type": "boolean" },
        "output_text": { "type": "string" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metrics": {
          "type": "object"
        }
      }
    },
    "failure": {
      "type": "object",
      "required": ["failed", "type"],
      "properties": {
        "failed": { "type": "boolean" },
        "type": {
          "type": "string",
          "enum": [
            "none",
            "connect_fail",
            "stream_init_fail",
            "frame_drop_high",
            "reconnect_slow",
            "sync_drift",
            "long_horizon_error",
            "landmark_hallucination",
            "repetitive_corridor_confusion",
            "instruction_not_actionable",
            "reflective_surface_fail",
            "textureless_fail",
            "mask_error",
            "depth_hole",
            "scale_alignment_fail",
            "other"
          ]
        },
        "note": { "type": "string" }
      }
    },
    "env": {
      "type": "object",
      "required": ["network_condition", "runtime"],
      "properties": {
        "network_condition": {
          "type": "string",
          "enum": ["normal", "weak", "lossy"]
        },
        "runtime": {
          "type": "string"
        },
        "lighting_condition": {
          "type": "string",
          "enum": ["bright", "normal", "low_light"]
        }
      }
    }
  }
}
